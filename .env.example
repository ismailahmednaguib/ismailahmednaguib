# انسخ إلى .env.local قبل التشغيل والنشر
# مفتاح الجلسة — ولّد واحد طويل (64 حرف) ولا تشاركه أبدا
JWT_SECRET=ضع_هاش_طويل_عشوائي_هنا_64_حرف_على_الأقل
# اسم الموقع فقط (لا أسرار هنا)
NEXT_PUBLIC_SITE_NAME=إسماعيل أحمد نجيب
# --- Supabase (الحفظ الدائم للبيانات على Vercel) ---
# من Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ضع_مفتاح_service_role_هنا_سري_جدا_للسيرفر_فقط
# --- Cloudflare R2 (ملفات PDF والصور الكبيرة - اختياري) ---
# من Cloudflare Dashboard -> R2 -> Manage R2 API tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=ضع_هنا
R2_SECRET_ACCESS_KEY=ضع_هنا
R2_BUCKET=ian-files
# رابط عام للباكت (من R2 -> bucket -> Settings -> Public access أو دومين مخصص)
# مثال: https://files.موقعك.com أو https://pub-xxxx.r2.dev
R2_PUBLIC_URL=



