# ==========================================
# إعدادات التشغيل المحلي - انسخ هذا الملف إلى .env.local
# ==========================================

# ---- JWT Secret (مطلوب - مفتاح طويل وآمن) ----
# أنشئ واحداً بـ: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret-key-here-change-in-production

# ---- Supabase (اختياري - للتخزين السحابي) ----
# من Supabase Dashboard -> Settings -> API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (سري - للسيرفر فقط)

# ---- Cloudflare R2 (اختياري - للملفات الكبيرة حتى 100MB) ----
# من Cloudflare Dashboard -> R2 -> Manage R2 API tokens
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET=your-bucket-name
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev (للروابط العامة)

# ---- Email (اختياري - للإشعارات) ----
# من Resend.com أو SendGrid
# EMAIL_FROM=noreply@yourdomain.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# أو
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# ---- Analytics (اختياري) ----
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxx

# ---- Site URL (للروابط المطلقة) ----
# NEXT_PUBLIC_SITE_URL=http://localhost:3000